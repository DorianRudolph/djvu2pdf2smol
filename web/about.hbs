<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Licenses · DjVu to PDF</title>
<link rel="icon" href="data:,">
<link rel="stylesheet" href="style.css">
</head>
<body>
<main class="legal">
  <p class="back"><a href="./">← DjVu to PDF</a></p>

  <h1>Open source licenses</h1>
  <p>
    This web app is built from the open source project
    <a href="https://github.com/DorianRudolph/djvu2pdf2smol">djvu2pdf2smol</a> (MIT or Apache-2.0)
    and includes the third-party software listed below.
  </p>

  <h2>pdf.js</h2>
  <p>
    The PDF viewer is <a href="https://github.com/mozilla/pdf.js">pdf.js</a> 4.10.38,
    Copyright Mozilla Foundation, licensed under the Apache License 2.0:
    <a href="pdfjs/LICENSE.txt">full license text</a>.
  </p>

  <h2>Rust standard library</h2>
  <p>
    Parts of the <a href="https://www.rust-lang.org/">Rust</a> standard library are compiled
    into the converter. Copyright The Rust Project Contributors, licensed under the MIT
    license or the Apache License 2.0; the complete copyright notices, including the
    standard library's own dependencies, are in
    <a href="rust-std-licenses.html">the notices published with the Rust toolchain</a>.
  </p>

  <h2>Rust crates in the converter</h2>
  <ul class="licenses-overview">
    {{#each overview}}
    <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
    {{/each}}
  </ul>

  {{#each licenses}}
  <section class="license">
    <h3 id="{{id}}">{{name}}</h3>
    <p class="used-by">Used by:
      {{#each used_by}}<a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a>{{#if crate.authors}} ({{#each crate.authors}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}){{/if}}{{#unless @last}}; {{/unless}}{{/each}}
    </p>
    <pre>{{text}}</pre>
  </section>
  {{/each}}
</main>
</body>
</html>
